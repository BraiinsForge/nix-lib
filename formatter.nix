pkgs:
# user-provided args
{ nix ? true
, rust ? true
, python ? true
, shell ? true
, protobuf ? true
, toml ? true
, yaml ? true
, json ? true
, javascript ? true
, typescript ? true
, css ? true
, html ? true
, graphql ? true
, markdown ? true
, caddyfile ? true
, copyright ? true
, config ? { }
}:
let
  lib = pkgs.lib;

  args = {
    inherit nix rust python shell protobuf toml yaml json javascript typescript css html graphql markdown caddyfile copyright;
    config = ({ withOpenDir ? false, exclude ? [ ] }: { inherit withOpenDir exclude; }) config;
  };

  # stolen from https://github.com/numtide/treefmt-nix/blob/29a3d7b768c70addce17af0869f6e2bd8f5be4b7/module-options.nix#L90
  defaultExcludes = [
    # generated lock files i.e. yarn, cargo, nix flakes
    "*.lock"
    # Files generated by patch
    "*.patch"

    # NPM
    "package-lock.json"

    # Go
    # In theory go mod tidy could format this, but it has other side-effects beyond formatting.
    "go.mod"
    "go.sum"

    # VCS
    ".gitignore"
    ".gitmodules"
    ".hgignore"
    ".svnignore"
  ];

  copyrightFiles = [ "*.rs" ];

  treefmtConfig = pkgs.treefmt.buildConfig {
    on-unmatched = "debug";
    excludes = args.config.exclude ++ defaultExcludes;
    formatter = with lib.modules; mkMerge [
      {
        nix = mkIf args.nix {
          command = lib.getExe pkgs.nixpkgs-fmt;
          includes = [ "*.nix" ];
        };
        rust = mkIf args.rust {
          command = lib.getExe pkgs.rustfmt;
          options = [ "--edition" "2024" ];
          includes = [ "*.rs" ];
        };
        python = mkIf args.python {
          command = lib.getExe pkgs.ruff;
          options = [ "format" "--no-cache" "--config" ./fmt-assets/ruff.toml ];
          includes = [ "*.py" "*.pyi" ];
        };
        shell = mkIf args.shell {
          command = lib.getExe pkgs.shfmt;
          options = [ "--simplify" "--write" "--binary-next-line" "--indent" "4" ];
          includes = [ "*.sh" "*.bash" "*.envrc" "*.envrc.*" ];
        };
        protobuf = mkIf args.protobuf {
          command = pkgs.writeShellScript "buf-format" "exec ${pkgs.buf}/bin/buf format --write";
          includes = [ "*.proto" ];
        };
        toml = mkIf args.toml {
          command = lib.getExe pkgs.taplo;
          options = [ "format" "--config" ./fmt-assets/taplo.toml ];
          includes = [ "*.toml" ];
        };
        yaml = mkIf args.yaml {
          command = lib.getExe pkgs.yamlfmt;
          options = [ "-conf" ./fmt-assets/yamlfmt.yml ];
          includes = [ "*.yaml" "*.yml" ];
        };
        json = mkIf args.json {
          command = lib.getExe pkgs.biome;
          options = [ "format" "--write" "--config-path" ./fmt-assets/biome.json ];
          includes = [ "*.json" "*.jsonc" ];
        };
        javascript = mkIf args.javascript {
          command = lib.getExe pkgs.biome;
          options = [ "format" "--write" "--config-path" ./fmt-assets/biome.json ];
          includes = [ "*.js" "*.mjs" "*.cjs" "*.jsx" ];
        };
        typescript = mkIf args.typescript {
          command = lib.getExe pkgs.biome;
          options = [ "format" "--write" "--config-path" ./fmt-assets/biome.json ];
          includes = [ "*.ts" "*.mts" "*.cts" "*.tsx" ];
        };
        css = mkIf args.css {
          command = lib.getExe pkgs.biome;
          options = [ "format" "--write" "--config-path" ./fmt-assets/biome.json ];
          includes = [ "*.css" ];
        };
        html = mkIf args.html {
          command = lib.getExe pkgs.biome;
          options = [ "format" "--write" "--config-path" ./fmt-assets/biome.json ];
          includes = [ "*.html" "*.htm" ];
        };
        graphql = mkIf args.graphql {
          command = lib.getExe pkgs.biome;
          options = [ "format" "--write" "--config-path" ./fmt-assets/biome.json ];
          includes = [ "*.graphql" "*.gql" ];
        };
        markdown = mkIf args.markdown {
          command = lib.getExe pkgs.mdformat;
          options = [ "--number" "--wrap=120" ];
          includes = [ "*.md" "*.markdown" ];
        };
        caddyfile = mkIf args.caddyfile {
          command = lib.getExe pkgs.caddy;
          options = [ "fmt" "--overwrite" ];
          includes = [ "Caddyfile" "**/Caddyfile" "*.caddyfile" ];
        };
        copyright = mkIf (args.copyright && !args.config.withOpenDir) {
          command = lib.getExe pkgs.addlicense;
          options = [ "-f" ./fmt-assets/copyright-closed.tpl ];
          includes = copyrightFiles;
          priority = 1;
        };
      }

      # two mutually exclusive instances of addlicense
      (mkIf (args.copyright && args.config.withOpenDir) {
        copyright = {
          command = lib.getExe pkgs.addlicense;
          options = [ "-f" ./fmt-assets/copyright-closed.tpl ];
          includes = copyrightFiles;
          excludes = [ "open/*" ];
          priority = 1;
        };
        copyright-open = {
          command = lib.getExe pkgs.addlicense;
          options = [ "-f" ./fmt-assets/copyright-open.tpl ];
          includes = map (pattern: "open/${pattern}") copyrightFiles;
          priority = 2;
        };
      })
    ];
  };
in
pkgs.writeShellApplication {
  name = "braiinsfmt";
  runtimeInputs = with pkgs; [ gitMinimal diffutils ]; # `diffutils` is required by `buf`
  runtimeEnv.PATH = null;
  excludeShellChecks = [ "SC2123" ];
  text = ''
    args=("$@")

    ${lib.optionalString (lib.versionOlder builtins.nixVersion "2.25") ''
      # remove `.` added automatically by `nix fmt` because it breaks `treefmt` when executed from a subdirectory
      for i in "''${!args[@]}"; do
        if [[ ''${args[i]} == "." ]]; then
          unset 'args[i]'
        fi
      done
    ''}

    if tree_root=$(git rev-parse --show-toplevel 2>/dev/null); then
      walk="git"
    else
      walk="filesystem"
      tree_root="."
    fi

    echo "formatter root: $tree_root ($walk)"

    exec ${pkgs.treefmt}/bin/treefmt \
      --config-file ${treefmtConfig} \
      --tree-root "$tree_root" \
      --walk "$walk" \
      "''${args[@]}"
  '';
}
