# inherited args
inputs: workspace:
# this fn's args
{ pkgs ? inputs.pkgs
, libcPkgs ? null
, stdenv ? null
, loadRustToolchain ? inputs.loadRustToolchain
, rustCrossTargetOverride ? null
, rustProfile ? "dev"
, minimalDeps ? false
, denix ? false
, upx ? "none"
, env ? { }
, crateEnv ? { }
, rustFlags ? [ ]
, nativeDeps ? _: [ ]
, targetDeps ? _: [ ]
, runtimeDeps ? [ ]
, runtimeEnv ? { }
, wrapNixGL ? false
, includeExtraSrc ? workspace.includeExtraSrc
}:
assert libcPkgs == null || stdenv == null; # only one of those two can be set
let lib = pkgs.lib; in
let pkgs' = pkgs; in
let pkgs = (pkgs'.extend inputs.fenix.overlays.default); in
let
  mkCraneLib = { pkgs, loadRustToolchain, registries ? _: [ ] }:
    let
      craneLib1 = inputs.crane.mkLib pkgs;
      craneLib2 = craneLib1.overrideToolchain loadRustToolchain;
      craneLib3 = craneLib2.appendCrateRegistries (registries craneLib1);
    in
    craneLib3;

  craneLib = mkCraneLib {
    inherit pkgs loadRustToolchain;
    registries = cl: [
      (cl.registryFromSparse {
        indexUrl = "http://registry.ii.zone/api/v1/crates/";
        configSha256 = "8ae51bd02f2645c885a8595e2c0bda4baf2855992b38b57328b444b9132ef1df";
      })
    ];
  };

  buildingForWindows = pkgs.stdenv.hostPlatform.isWindows;
  buildingForDarwin = pkgs.stdenv.hostPlatform.isDarwin;
  isCross = pkgs.stdenv.hostPlatform != pkgs.stdenv.buildPlatform;

  rustCrossTarget = if rustCrossTargetOverride != null then rustCrossTargetOverride else pkgs.stdenv.hostPlatform.rust.rustcTarget;
  target' = lib.replaceStrings [ "-" ] [ "_" ] rustCrossTarget;
  TARGET' = lib.toUpper target';

  cargoCrossEnvVars = lib.optionalAttrs isCross
    (
      let
        stdenv = pkgs.stdenv;
        cross_cc = "${stdenv.cc}/bin/${stdenv.cc.targetPrefix}cc";
        host_cc = "${pkgs.pkgsBuildBuild.stdenv.cc}/bin/${stdenv.cc.nativePrefix}cc";
      in
      {
        "CC_${target'}" = cross_cc;
        "CARGO_TARGET_${TARGET'}_LINKER" = cross_cc;
        CARGO_BUILD_TARGET = rustCrossTarget;
        HOST_CC = host_cc;
      }
    )
  // lib.optionalAttrs (!isCross && rustCrossTargetOverride != null) {
    CARGO_BUILD_TARGET = rustCrossTarget;
  };

  # TODO join with cargoCrossEnvVars?
  cargoRunnerEmulator = lib.optionalAttrs isCross {
    "CARGO_TARGET_${TARGET'}_RUNNER" = pkgs.stdenv.hostPlatform.emulator pkgs.buildPackages;
  };

  # builtin rustflags used to disable warnings generated by dummy src
  dummy_src_rustflags = [
    "-Aunused-extern-crates"
    "-Aunused-crate-dependencies"
  ];

  # Setting RUSTFLAGS caused that flags in `.cargo/config.toml` were ignored, and CARGO_BUILD_RUSTFLAGS simply didn't work...
  # This horrible hack seems to be the only way to inject custom rust flags. Note that `$CARGO_HOME/config.toml` != `.cargo/config.toml`
  mkRustFlagsHack = flags: {
    postConfigure = ''
      cat "${craneLib.writeTOML "crazy_hack.toml" { target."cfg(all())".rustflags = flags; }}" >> "$CARGO_HOME/config.toml"
    '';
  };

  rustflags = workspace.rustFlags ++ rustFlags
    ++ (lib.optionals buildingForWindows [ "-Ctarget-feature=+crt-static" ]);

  # set of arguments that must be the same for `buildDepsOnly` and `buildPackage`, to prevent full workspace rebuilds in `buildPackage`
  commonArgs =
    let
      args = {
        # packages specified in workspace and profile definitions
        nativeBuildInputs = (workspace.nativeDeps pkgs.pkgsBuildBuild) ++ (nativeDeps pkgs.pkgsBuildBuild);
        buildInputs = (workspace.targetDeps pkgs) ++ (targetDeps pkgs)
          ++ (lib.optionals buildingForWindows [ pkgs.windows.pthreads ])
          ++ (lib.optionals buildingForDarwin [ pkgs.libiconv ]);

        # Native compiler for build scripts / proc-macros when cross-compiling,
        # plus special packages for windows/darwin cross-compilation.
        depsBuildBuild = lib.optionals isCross [ pkgs.pkgsBuildBuild.stdenv.cc ]
          ++ lib.optionals buildingForWindows [ pkgs.pkgsBuildBuild.libiconv ];

        CARGO_PROFILE = rustProfile;

        # NOTE: This was previously enabled, but I disabled it because it seems to have no effect (zstd is used instead of symlinking by default since Crane 0.15.0)
        # doNotLinkInheritedArtifacts = true; # https://github.com/ipetkov/crane/issues/385

        strictDeps = true;

        # incremental compilation is always counterproductive in sandbox
        CARGO_INCREMENTAL = "0";
      };
      rustFlagsHack = mkRustFlagsHack (rustflags ++ dummy_src_rustflags);
    in
    args
    // cargoCrossEnvVars
    // (if workspace.enableRustFlagsHack then rustFlagsHack else { })
    // workspace.env
    // env
    // lib.optionalAttrs (stdenv != null) { inherit stdenv; }
    // lib.optionalAttrs (libcPkgs != null) {
      stdenv = (import ../lib.nix pkgs.pkgsBuildBuild).stdenvCustomLibc {
        inherit pkgs;
        libc = libcPkgs.glibc;
        libcxx = libcPkgs.libcxx;
      };
    };

  workspacePath = workspace.workspacePath;
  workspacePrefix = lib.optionalString (workspacePath != "") "${workspacePath}/";

  dummySrc = craneLib.mkDummySrc ({
    src = workspace.src;
  } // lib.optionalAttrs (workspacePath != "") {
    extraDummyScript = ''
      cp ${workspace.src}/${workspacePrefix}Cargo.lock $out/${workspacePrefix}Cargo.lock
    '';
  });

  workspacePostUnpack = lib.optionalString (workspacePath != "") ''
    sourceRoot="$sourceRoot/${workspacePath}"
  '';

  # Vendor all Cargo dependencies once per profile.
  cargoVendorDir = craneLib.vendorCargoDeps ({
    src = workspace.src;
  } // lib.optionalAttrs (workspacePath != "") {
    cargoLock = "${workspace.src}/${workspacePrefix}Cargo.lock";
  });

  ####################################################################
  # build all dependencies of all packages in the virtual workspace
  # (equivalent to passing --workspace)
  #
  # This is similar to what cargo-chef does in the bos-main pipeline.
  # Most dependencies are independent from the sources your crate has,
  # so we can do a clean build with a dummy sources, and then we can
  # transplant the target/ folder into the actual build of the crate,
  # saving a lot of time.
  ####################################################################
  commonCargoArtifacts = craneLib.buildDepsOnly (commonArgs // {
    inherit cargoVendorDir;
    inherit dummySrc;
    pname = "workspace";
    version = "0.0.0";
    cargoExtraArgs = "--locked --all-targets";
    doCheck = false;
    postUnpack = workspacePostUnpack;
  });

  mkShell =
    { name ? "build-env"
    , packages ? [ ]
    , inputsFrom ? [ ]
    , shellHook ? ""
    , env ? { }
    }: pkgs.mkShell ((builtins.removeAttrs commonArgs [ "CARGO_INCREMENTAL" ]) // {
      inherit name;
      packages = [ craneLib.cargo pkgs.stdenv.cc ] ++ packages;
      inherit inputsFrom env;
      shellHook = lib.optionalString isCross ''
        if [ -t 1 ]; then
          _bold=$'\e[1m' _blue=$'\e[34m' _reset=$'\e[0m'
        else
          _bold="" _blue="" _reset=""
        fi
        echo "''${_bold}Entering cross compilation environment...''${_reset}"
        echo "  - GCC: ''${_blue}$(${pkgs.stdenv.cc.targetPrefix}cc --version | head -n1)''${_reset}"
        echo "  - Rust: ''${_blue}$(rustc --version)''${_reset}"
        echo "  - CARGO_BUILD_TARGET: ''${_blue}$CARGO_BUILD_TARGET''${_reset}"
        echo "  - CARGO_PROFILE: ''${_blue}$CARGO_PROFILE''${_reset}"
      '' + shellHook;
    });

  shell = mkShell { };

  workspaceCommonArgs = {
    # # TODO: clean source, but include assets
    # src = craneLib.cleanCargoSource workspace.src;
    inherit cargoVendorDir;
    src = workspace.src;
    pname = "workspace";
    cargoArtifacts = commonCargoArtifacts;
    doInstallCargoArtifacts = false;
    postUnpack = workspacePostUnpack;
  } // crateEnv;

  # derivation that runs `cargo build` on the entire workspace
  build = craneLib.cargoBuild (commonArgs // workspaceCommonArgs // {
    version = "0.0.0";
    cargoExtraArgs = "--workspace" + (if workspace.disableKeepGoing then "" else " --keep-going");
    fixupPhase = ":";
    doCheck = false;
  });

  # derivation that runs `cargo clippy` on the entire workspace
  clippy = craneLib.cargoClippy (commonArgs // workspaceCommonArgs // {
    version = "0.0.0";
    cargoExtraArgs = "--workspace" + (if workspace.disableKeepGoing then "" else " --keep-going");
    cargoClippyExtraArgs = "--all-targets -- -D warnings";
    fixupPhase = ":";
    doCheck = false;
  });

  # derivation that runs `cargo test` on the entire workspace
  test = craneLib.cargoTest (commonArgs // workspaceCommonArgs // {
    version = "0.0.0";
    cargoExtraArgs = "--workspace";
    fixupPhase = ":";
    doCheck = true;
  } // cargoRunnerEmulator);

  # derivation that runs `cargo nextest run` on the entire workspace
  nextest = craneLib.cargoNextest (commonArgs // workspaceCommonArgs // {
    version = "0.0.0";
    cargoNextestExtraArgs = "--workspace --hide-progress-bar";
    fixupPhase = ":";
    doCheck = true;
  } // cargoRunnerEmulator);

  # derivation that runs `cargo deny check` on the entire workspace
  mkCargoDeny =
    { config ? false
    , checks ? [ "bans" "licenses" "sources" ]
    }: craneLib.cargoDeny (commonArgs // workspaceCommonArgs // {
      version = "0.0.0";
      cargoExtraArgs = if config != false then "--config ${config}" else "";
      cargoDenyChecks = if builtins.isList checks then builtins.concatStringsSep " " checks else checks;
      fixupPhase = ":";
      doCheck = true;
    });
in
{
  inherit stdenv;
  deps = commonCargoArtifacts;
  inherit mkShell shell;
  inherit build clippy test nextest mkCargoDeny;
  inherit pkgs;
  cc = pkgs.stdenv.cc;
  buildCrate = import ./buildCrate.nix inputs workspace {
    inherit pkgs craneLib rustProfile minimalDeps denix upx env crateEnv rustFlags nativeDeps targetDeps runtimeDeps runtimeEnv wrapNixGL;
    inherit commonArgs commonCargoArtifacts cargoVendorDir dummySrc;
    inherit includeExtraSrc workspacePostUnpack;
  };
}
