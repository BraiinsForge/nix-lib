# inherited args
inputs: workspace:
# this fn's args
{ build_pkgs ? inputs.pkgs, suffix ? null, rustCrossTarget ? null, rustProfile ? "dev", env ? { }, rustFlags ? [ ], nativeDeps ? _: [ ], targetDeps ? _: [ ] }:
let
  pkgs = inputs.pkgs;
  lib = inputs.pkgs.lib;
  craneLib = inputs.craneLib;
  nix-filter = inputs.nix-filter;
in
with builtins;
let
  profile_suffix = if suffix != null then "-${suffix}" else "";

  buildingForWindows = build_pkgs.stdenv.hostPlatform.isWindows;

  makeCargoCrossEnvVars = stdenv: target:
    let
      target' = lib.replaceStrings [ "-" ] [ "_" ] target;
      TARGET' = lib.toUpper target';
      cross_cc = "${stdenv.cc}/bin/${stdenv.cc.targetPrefix}cc";
      host_cc = "${pkgs.pkgsBuildBuild.stdenv.cc}/bin/${stdenv.cc.nativePrefix}cc";
    in
    {
      "CC_${target'}" = cross_cc;
      "CARGO_TARGET_${TARGET'}_LINKER" = cross_cc;
      CARGO_BUILD_TARGET = target;
      HOST_CC = host_cc;
    };

  # builtin rustflags used to disable warnings generated by dummy src
  dummy_src_rustflags = [
    "-Aunused-extern-crates"
    "-Aunused-crate-dependencies"
  ];

  # Setting RUSTFLAGS caused that flags in `.cargo/config.toml` were ignored, and CARGO_BUILD_RUSTFLAGS simply didn't work...
  # This horrible hack seems to be the only way to inject custom rust flags. Note that `$CARGO_HOME/config.toml` != `.cargo/config.toml`
  mkRustFlagsHack = flags: {
    postConfigure = ''
      cat "${craneLib.writeTOML "crazy_hack.toml" { target."cfg(all())".rustflags = flags; }}" >> "$CARGO_HOME/config.toml"
    '';
  };

  rustflags = workspace.rustFlags ++ rustFlags
    ++ (lib.optionals buildingForWindows [ "-Ctarget-feature=+crt-static" ]);

  # set of arguments that must be the same for `buildDepsOnly` and `buildPackage`, to prevent full workspace rebuilds in `buildPackage`
  commonArgs =
    let
      args = {
        # packages specified in workspace and profile definitions
        nativeBuildInputs = (workspace.nativeDeps pkgs) ++ (nativeDeps pkgs);
        buildInputs = (workspace.targetDeps build_pkgs) ++ (targetDeps build_pkgs);

        # special packages just for windows cross-compilation
        # plus libiconv, which is needed on both Mac and Windows
        depsBuildBuild = with build_pkgs; (lib.optionals buildingForWindows [ stdenv.cc windows.pthreads ]) ++ [ libiconv ];

        CARGO_PROFILE = rustProfile;

        # NOTE: This was previously enabled, but I disabled it because it seems to have no effect (zstd is used instead of symlinking by default since Crane 0.15.0)
        # doNotLinkInheritedArtifacts = true; # https://github.com/ipetkov/crane/issues/385

        strictDeps = true;
      };
      cargoCrossEnvVars = lib.optionalAttrs (rustCrossTarget != null) (makeCargoCrossEnvVars build_pkgs.stdenv rustCrossTarget);
      rustFlagsHack = mkRustFlagsHack (rustflags ++ dummy_src_rustflags);
    in
    args // cargoCrossEnvVars // rustFlagsHack // workspace.env // env;

  ####################################################################
  # build all dependencies of all packages in the virtual workspace
  # (equivalent to passing --workspace)
  #
  # This is similar to what cargo-chef does in the bos-main pipeline.
  # Most dependencies are independent from the sources your crate has,
  # so we can do a clean build with a dummy sources, and then we can
  # transplant the target/ folder into the actual build of the crate,
  # saving a lot of time.
  ####################################################################
  commonCargoArtifacts = craneLib.buildDepsOnly (commonArgs // {
    src = workspace.manifests_src;
    pname = "workspace" + profile_suffix;
    version = "0.0.0";
    cargoExtraArgs = "--all-targets";
    doCheck = false;
    preBuild = ''
      echo "checking Cargo.lock"
      cp Cargo.lock Cargo.lock.orig
      cargo metadata --format-version 1 >/dev/null
      if ! ${pkgs.git}/bin/git diff --exit-code --no-index Cargo.lock.orig Cargo.lock; then
        echo -e "\033[31merror\033[0m: Cargo.lock is not up to date!"
        exit 1
      fi
      mv Cargo.lock.orig Cargo.lock
    '';
  });

  shell = pkgs.mkShell (commonArgs // {
    name = "build-env" + profile_suffix;
    packages = [ craneLib.cargo ];
    shellHook = if rustCrossTarget == null then "" else ''
      echo "Entering cross compilation environment for '${rustCrossTarget}'..."
    '';
  });

  workspaceCommonArgs = {
    # # TODO: clean source, but include assets
    # src = craneLib.cleanCargoSource workspace.src;
    src = workspace.src;
    pname = "workspace" + profile_suffix;
    cargoArtifacts = commonCargoArtifacts;
    doInstallCargoArtifacts = false;
  };

  # derivation that runs `cargo build` on the entire workspace
  build = craneLib.cargoBuild (commonArgs // workspaceCommonArgs // {
    version = "0.0.0";
    cargoExtraArgs = "--workspace";
    fixupPhase = ":";
    doCheck = false;
  });

  # derivation that runs `cargo clippy` on the entire workspace
  clippy = craneLib.cargoClippy (commonArgs // workspaceCommonArgs // {
    version = "0.0.0";
    cargoExtraArgs = "--workspace";
    cargoClippyExtraArgs = "--all-targets -- -D warnings";
    fixupPhase = ":";
    doCheck = false;
  });

  # derivation that runs `cargo test` on the entire workspace
  test = craneLib.cargoTest (commonArgs // workspaceCommonArgs // {
    version = "0.0.0";
    cargoExtraArgs = "--workspace";
    fixupPhase = ":";
    doCheck = true;
  });
in
{
  deps = commonCargoArtifacts;
  inherit shell;
  inherit build clippy test;
  buildCrate = import ./buildCrate.nix inputs workspace {
    inherit build_pkgs rustCrossTarget rustProfile env rustFlags nativeDeps targetDeps;
    inherit commonArgs commonCargoArtifacts;
    suffix = profile_suffix;
  };
}
